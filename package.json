{
  "name": "agro-olam-ai-agronom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "concurrently -n next,api -c green,blue \"next dev\" \"tsx watch server/index.ts\"",
    "build": "node scripts/prisma-generate.js && node scripts/prisma-migrate-deploy.js && node scripts/kb-bootstrap-build.js && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "start:api": "tsx server/index.ts",
    "test": "npm run test:lang && npm run test:kb && npm run test:kb-phase2 && npm run test:kb-audit && npm run test:kb-db && npm run test:kb-phase4 && npm run test:api-compat",
    "test:lang": "tsx scripts/test-language-detection.ts",
    "test:kb": "tsx scripts/test-kb-rag.ts",
    "test:kb-phase2": "tsx scripts/test-kb-phase2.ts",
    "test:kb-audit": "tsx scripts/test-kb-audit-fixes.ts",
    "test:kb-db": "tsx scripts/test-kb-db-migration.ts",
    "test:kb-phase4": "tsx scripts/test-kb-phase4.ts",
    "test:api-compat": "tsx scripts/test-api-compat.ts",
    "test:smoke": "node scripts/production-api-smoke.js",
    "kb:ingest": "tsx scripts/kb-ingest.ts",
    "kb:stats": "tsx scripts/kb-stats.ts",
    "kb:sync": "tsx scripts/kb-sync.ts",
    "kb:migrate-corpus": "tsx scripts/kb-migrate-corpus.ts",
    "kb:verify-products": "tsx scripts/kb-verify-products.ts",
    "kb:corpus-stats": "tsx scripts/kb-stats.ts",
    "kb:reindex": "tsx scripts/kb-reindex.ts",
    "kb:embedding-status": "tsx scripts/kb-embedding-status.ts",
    "kb:import-kz-ppp": "tsx scripts/kb-import-kz-ppp.ts",
    "prisma:generate": "node scripts/prisma-generate.js",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "node scripts/prisma-migrate-deploy.js",
    "postinstall": "node scripts/prisma-generate.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "framer-motion": "^12.42.2",
    "helmet": "^8.0.0",
    "jspdf": "^4.2.1",
    "next": "^14.2.0",
    "next-themes": "^0.4.6",
    "openai": "^4.77.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
