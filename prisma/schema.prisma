// Production Prisma schema — Agro Olam Knowledge Base
// Activate with DATABASE_URL. Without it, runtime uses corpus fallback.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, unaccent]
}

enum KbStatus {
  DRAFT
  AI_PARSED
  NEEDS_REVIEW
  VERIFIED
  REJECTED
  ARCHIVED
  AI_TRANSLATED
  VERIFIED_TRANSLATION
  CONFLICT
  EXPIRED
  REVOKED
}

enum EntityType {
  crop
  disease
  pest
  symptom
  treatment
  prevention
  product
  nutrient
  irrigation
  soil
  general
}

enum RegistrationStatus {
  ACTIVE
  EXPIRED
  REVOKED
  UNKNOWN
}

model Source {
  id               String              @id
  title            String
  organization     String
  url              String
  publishedAt      DateTime?
  accessedAt       DateTime
  license          String
  reliabilityScore Float
  checksum         String?
  registryId       String?
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  version          Int                 @default(1)
  documents        KnowledgeDocument[]
  chunks           KnowledgeChunkRow[]

  @@index([organization])
  @@index([checksum])
}

model Crop {
  id             String            @id
  scientificName String?
  cropGroup      String?
  tempC          String?
  humidity       String?
  soil           String?
  ph             String?
  irrigation     String?
  regions        String[]
  status         KbStatus          @default(VERIFIED)
  qualityScore   Int               @default(70)
  checksum       String?
  version        Int               @default(1)
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  verifiedAt     DateTime?
  verifiedBy     String?
  translations   CropTranslation[]
  synonyms       CropSynonym[]

  @@index([scientificName])
  @@index([status])
}

model CropTranslation {
  id     String @id @default(cuid())
  cropId String
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  lang   String
  name   String
  status KbStatus @default(VERIFIED)

  @@unique([cropId, lang])
  @@index([name])
}

model CropSynonym {
  id     String @id @default(cuid())
  cropId String
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  lang   String
  name   String

  @@index([name])
  @@unique([cropId, lang, name])
}

model Disease {
  id               String               @id
  scientificName   String?
  eppoCode         String?
  pathogenType     String?
  pathogenName     String?
  severity         String?
  quarantineStatus String?
  status           KbStatus             @default(VERIFIED)
  qualityScore     Int                  @default(70)
  checksum         String?
  version          Int                  @default(1)
  sourceUrl        String?
  organization     String?
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  verifiedAt       DateTime?
  verifiedBy       String?
  translations     DiseaseTranslation[]
  synonyms         DiseaseSynonym[]

  @@unique([eppoCode])
  @@index([scientificName])
  @@index([status])
}

model DiseaseTranslation {
  id        String  @id @default(cuid())
  diseaseId String
  disease   Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  lang      String
  name      String
  status    KbStatus @default(VERIFIED)

  @@unique([diseaseId, lang])
  @@index([name])
}

model DiseaseSynonym {
  id        String  @id @default(cuid())
  diseaseId String
  disease   Disease @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  lang      String
  name      String

  @@index([name])
}

model Pest {
  id             String            @id
  scientificName String?
  eppoCode       String?
  pestType       String?
  taxonomy       String?
  status         KbStatus          @default(VERIFIED)
  qualityScore   Int               @default(70)
  checksum       String?
  version        Int               @default(1)
  sourceUrl      String?
  organization   String?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  verifiedAt     DateTime?
  verifiedBy     String?
  translations   PestTranslation[]
  synonyms       PestSynonym[]

  @@unique([eppoCode])
  @@index([scientificName])
  @@index([status])
}

model PestTranslation {
  id     String @id @default(cuid())
  pestId String
  pest   Pest   @relation(fields: [pestId], references: [id], onDelete: Cascade)
  lang   String
  name   String
  status KbStatus @default(VERIFIED)

  @@unique([pestId, lang])
  @@index([name])
}

model PestSynonym {
  id     String @id @default(cuid())
  pestId String
  pest   Pest   @relation(fields: [pestId], references: [id], onDelete: Cascade)
  lang   String
  name   String

  @@index([name])
}

model Symptom {
  id                    String    @id
  cropId                String?
  diseaseId             String?
  pestId                String?
  plantPart             String?
  visualDescription     String
  color                 String?
  shape                 String?
  texture               String?
  pattern               String?
  distribution          String?
  earlyStage            String?
  lateStage             String?
  progression           String?
  distinguishingFeatures String?
  confusedWith          String[]
  language              String    @default("en")
  sourceUrl             String?
  organization          String?
  status                KbStatus  @default(VERIFIED)
  qualityScore          Int       @default(70)
  checksum              String?
  version               Int       @default(1)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([cropId, diseaseId])
  @@index([status])
  @@index([checksum])
}

model Treatment {
  id               String    @id
  conditionId      String
  conditionType    String
  cropId           String?
  treatmentType    String
  method           String
  timing           String?
  growthStage      String?
  region           String?
  greenhouse       Boolean?
  restrictions     String?
  safetyNotes      String?
  sourceUrl        String?
  organization     String?
  status           KbStatus  @default(NEEDS_REVIEW)
  qualityScore     Int       @default(60)
  checksum         String?
  version          Int       @default(1)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([conditionId, treatmentType])
  @@index([status])
}

model Prevention {
  id            String    @id
  conditionId   String
  conditionType String
  cropId        String?
  method        String
  timing        String?
  sourceUrl     String?
  organization  String?
  status        KbStatus  @default(VERIFIED)
  qualityScore  Int       @default(75)
  checksum      String?
  version       Int       @default(1)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([conditionId])
  @@index([status])
}

model ActiveIngredient {
  id         String    @id
  name       String
  type       String
  status     KbStatus  @default(NEEDS_REVIEW)
  checksum   String?
  version    Int       @default(1)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@index([name])
  @@index([status])
}

model Product {
  id                   String                @id
  marketplaceProductId String?
  name                 String
  activeIngredientId   String?
  activeIngredient     ActiveIngredient?     @relation(fields: [activeIngredientId], references: [id])
  formulation          String?
  manufacturer         String?
  labelUrl             String?
  labelVerified        Boolean               @default(false)
  safetyInterval       String?
  reentryInterval      String?
  pollinatorWarning    String?
  aquaticWarning       String?
  status               KbStatus              @default(NEEDS_REVIEW)
  registrationStatus   RegistrationStatus    @default(UNKNOWN)
  qualityScore         Int                   @default(40)
  checksum             String?
  version              Int                   @default(1)
  lastVerifiedAt       DateTime?
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  registrations        ProductRegistration[]

  @@index([status, registrationStatus, labelVerified])
  @@index([name])
  @@index([checksum])
}

model ProductRegistration {
  id                  String             @id @default(cuid())
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  registrationCountry String
  registrationNumber  String
  approvedCrops       String[]
  approvedTargets     String[]
  expiresAt           DateTime?
  status              KbStatus           @default(NEEDS_REVIEW)
  registrationStatus  RegistrationStatus @default(UNKNOWN)
  checksum            String?
  lastVerifiedAt      DateTime?
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([registrationCountry, registrationNumber])
  @@index([registrationNumber])
}

model KnowledgeDocument {
  id        String             @id @default(cuid())
  title     String
  language  String
  sourceId  String
  source    Source             @relation(fields: [sourceId], references: [id])
  content   String
  checksum  String
  status    KbStatus           @default(NEEDS_REVIEW)
  version   Int                @default(1)
  deletedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  chunks    KnowledgeChunkRow[]

  @@index([checksum])
  @@index([status])
}

/// DB table for RAG chunks (named to avoid clash with TS KnowledgeChunk type)
model KnowledgeChunkRow {
  id               String             @id
  documentId       String?
  document         KnowledgeDocument? @relation(fields: [documentId], references: [id])
  entityType       EntityType
  entityId         String
  language         String
  title            String
  content          String
  keywords         String[]
  cropIds          String[]
  plantParts       String[]
  regions          String[]
  sourceId         String
  source           Source             @relation(fields: [sourceId], references: [id])
  sourceUrl        String
  sourceTitle      String
  organization     String
  reliabilityScore Float
  qualityScore     Int                @default(50)
  status           KbStatus           @default(NEEDS_REVIEW)
  version          Int                @default(1)
  checksum         String
  /// Stored as float array JSON until pgvector column enabled in raw SQL
  embeddingJson    Json?
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  verifiedAt       DateTime?
  embeddingJobs    EmbeddingJob[]

  @@index([entityType, entityId])
  @@index([status, language])
  @@index([checksum])
  @@index([qualityScore])
  @@index([sourceId])
}

model ImageReference {
  id             String    @id @default(cuid())
  conditionId    String?
  cropId         String?
  plantPart      String?
  imageUrl       String
  license        String
  attribution    String?
  sourceId       String?
  verified       Boolean   @default(false)
  imageHash      String?
  visualFeatures String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([imageHash])
}

model ImportJob {
  id             String          @id @default(cuid())
  kind           String
  status         String
  progressJson   Json
  idempotencyKey String          @unique
  attempts       Int             @default(0)
  lastError      String?
  checkpoint     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          ImportJobItem[]
  errors         ImportError[]
}

model ImportJobItem {
  id         String    @id @default(cuid())
  jobId      String
  job        ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  externalId String
  url        String?
  status     String
  checksum   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([jobId, externalId])
}

model ImportError {
  id         String    @id @default(cuid())
  jobId      String
  job        ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  externalId String?
  url        String?
  error      String
  createdAt  DateTime  @default(now())
}

model DuplicateCandidate {
  id            String   @id @default(cuid())
  leftEntityId  String
  rightEntityId String
  confidence    Float
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  @@index([status])
}

model ConflictRecord {
  id                   String     @id
  entityType           EntityType
  canonicalEntityId    String
  conflictingEntityIds String[]
  reason               String
  fields               String[]
  status               String     @default("pending")
  sources              String[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([status])
}

model VerificationTask {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  status     KbStatus   @default(NEEDS_REVIEW)
  assignee   String?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status, entityType])
}

model EmbeddingJob {
  id        String            @id @default(cuid())
  chunkId   String
  chunk     KnowledgeChunkRow @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  model     String
  status    String            @default("pending")
  error     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorHash  String
  action     String
  entityType String?
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
