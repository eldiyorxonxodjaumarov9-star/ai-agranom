{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Dehqon API",
    "description": "Professional public API for AI agronomy chat and plant vision analysis. Use Bearer token authentication.",
    "version": "1.1.0",
    "contact": {
      "name": "Agro Olam",
      "url": "https://ai-agranom.vercel.app"
    }
  },
  "servers": [
    {
      "url": "https://ai-agranom.vercel.app",
      "description": "Vercel Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "AGRO_API_KEY from Vercel Environment Variables"
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "Pomidor barglari sarg'aymoqda",
            "maxLength": 2000
          },
          "language": {
            "type": "string",
            "enum": ["auto", "uz", "ru", "en"],
            "default": "auto"
          },
          "sessionId": {
            "type": "string",
            "example": "user-session-123",
            "description": "Optional session ID for multi-turn conversation"
          }
        }
      },
      "ChatSuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "answer": { "type": "string" },
          "language": { "type": "string", "example": "uz" },
          "service": { "type": "string", "example": "agro-olam-ai-agronom" }
        }
      },
      "VisionImage": {
        "type": "object",
        "description": "Provide one of url (http/https or data:image/*), dataUri, or base64.",
        "properties": {
          "url": {
            "type": "string",
            "description": "HTTPS image URL or data:image/* URI",
            "example": "https://example.com/leaf.jpg"
          },
          "base64": {
            "type": "string",
            "description": "Raw base64 image payload (no data: prefix)"
          },
          "dataUri": {
            "type": "string",
            "description": "Full data URI, e.g. data:image/jpeg;base64,..."
          }
        }
      },
      "VisionRequest": {
        "type": "object",
        "required": ["images"],
        "properties": {
          "images": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "description": "Max 5 images, each up to 10 MB. Allowed: image/jpeg, image/png, image/webp, image/gif.",
            "items": {
              "oneOf": [
                { "$ref": "#/components/schemas/VisionImage" },
                {
                  "type": "string",
                  "description": "URL, data URI, or bare base64 string"
                }
              ]
            }
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "example": "Pomidor bargida nima muammo bor?"
          },
          "language": {
            "type": "string",
            "enum": ["auto", "uz", "ru", "kk", "ky"],
            "default": "auto"
          },
          "sessionId": { "type": "string", "maxLength": 128 },
          "region": { "type": "string", "example": "Toshkent" },
          "crop": { "type": "string", "example": "Pomidor" }
        }
      },
      "VisionDiseaseOrPest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.99,
            "description": "Never 1.0 — model must not claim 100% diagnosis"
          }
        }
      },
      "VisionAnalysis": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 0.99 },
          "possibleDiseases": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VisionDiseaseOrPest" }
          },
          "possiblePests": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VisionDiseaseOrPest" }
          },
          "recommendedNextImages": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requiresExpertReview": { "type": "boolean" }
        }
      },
      "VisionSuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "service": { "type": "string", "example": "agro-olam-ai-agronom" },
          "language": { "type": "string", "example": "uz" },
          "analysis": { "$ref": "#/components/schemas/VisionAnalysis" },
          "recommendation": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "organization": { "type": "string" },
                "title": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "service": { "type": "string", "example": "agro-olam-ai-agronom" },
          "version": { "type": "string", "example": "1.0.0" }
        }
      }
    }
  },
  "paths": {
    "/api/agronom/health": {
      "get": {
        "summary": "Health check",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "status": "ok",
                  "service": "agro-olam-ai-agronom",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    },
    "/api/agronom/chat": {
      "post": {
        "summary": "AI Dehqon chat",
        "description": "Send an agronomy question and receive AI-powered advice. Contract unchanged — vision is a separate endpoint.",
        "tags": ["Chat"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" },
              "examples": {
                "agro": {
                  "summary": "Agro question",
                  "value": {
                    "message": "Pomidor barglari sarg'aymoqda",
                    "language": "auto",
                    "sessionId": "session-123"
                  }
                },
                "nonAgro": {
                  "summary": "Non-agro question",
                  "value": {
                    "message": "Messi kim?",
                    "language": "uz"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatSuccessResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "error": "message bo'sh bo'lmasligi kerak." }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "error": "Unauthorized" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "error": "Too many requests. Please try again later."
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "error": "AI javob berishda muammo bo'ldi" }
              }
            }
          }
        }
      }
    },
    "/api/agronom/vision": {
      "post": {
        "summary": "Plant vision analysis",
        "description": "Analyze up to 5 plant images (URL, data URI, or base64), then ground recommendations in Knowledge Base / RAG. Never returns 100% diagnosis. Low confidence sets requiresExpertReview=true. Does not modify POST /api/agronom/chat.",
        "tags": ["Vision"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VisionRequest" },
              "examples": {
                "urlImage": {
                  "summary": "HTTPS image URL",
                  "value": {
                    "images": [{ "url": "https://example.com/image1.jpg" }],
                    "message": "Pomidor bargida nima muammo bor?",
                    "language": "uz",
                    "sessionId": "user-123",
                    "region": "Toshkent",
                    "crop": "Pomidor"
                  }
                },
                "dataUri": {
                  "summary": "Data URI",
                  "value": {
                    "images": [
                      {
                        "url": "data:image/jpeg;base64,/9j/4AAQ..."
                      }
                    ],
                    "message": "What is wrong with this leaf?",
                    "language": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vision analysis success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VisionSuccessResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "error": "Unauthorized" }
              }
            }
          },
          "413": {
            "description": "Too many images or image too large (max 5 images, 10 MB each)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "error": "Too many images" }
              }
            }
          },
          "415": {
            "description": "Unsupported image (mime, SSRF-blocked URL, invalid fetch)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "error": "Unsupported image" }
              }
            }
          },
          "422": {
            "description": "Invalid request (malformed body/base64)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "error": "Invalid request" }
              }
            }
          },
          "429": {
            "description": "Rate limit",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "error": "Too many requests. Please try again later."
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "error": "Internal error" }
              }
            }
          }
        }
      }
    }
  }
}
