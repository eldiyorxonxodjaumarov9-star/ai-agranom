# ===========================================
# Vercel / Local Environment Variables
# ===========================================

# OpenAI (server only — never expose to frontend)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

# Public API authentication (Bearer token for external clients)
AGRO_API_KEY=super_secret_api_key_here

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://ai-agranom.vercel.app,https://agroolam.uz,https://www.agroolam.uz

# Optional: embedding model for Knowledge Base RAG (Phase 1)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Phase 2: optional live conditional GET for allowlisted official URLs (ETag/Last-Modified)
# KB_LIVE_FETCH=0

# Vercel Cron auth for /api/cron/kb-sync (falls back to AGRO_API_KEY if unset)
# CRON_SECRET=your_cron_secret_here

# Optional: Postgres + pgvector (Phase 2+) — not required for file store
# DATABASE_URL=postgresql://user:pass@host:5432/ai_agranom

# Optional: external API base URL for frontend (usually empty on Vercel)
# NEXT_PUBLIC_API_URL=
