# ===========================================
# Vercel / Local Environment Variables
# ===========================================

# OpenAI (server only — never expose to frontend)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

# Public API authentication (Bearer token for external clients)
AGRO_API_KEY=super_secret_api_key_here

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://ai-agranom.vercel.app,https://agroolam.uz,https://www.agroolam.uz

# Optional: embedding model for Knowledge Base RAG
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL / Neon (Vercel integration)
# DATABASE_URL=postgresql://...          # pooled OK for app runtime
# DATABASE_URL_UNPOOLED=postgresql://... # preferred for prisma migrate deploy
# POSTGRES_URL_NON_POOLING=postgresql://...
# POSTGRES_PRISMA_URL=postgresql://...
# DIRECT_URL is NOT required (schema has no directUrl)

# Force corpus even if DATABASE_URL is set
# KB_FORCE_CORPUS=0

# Optional live conditional GET for allowlisted official URLs
# KB_LIVE_FETCH=0

# Vercel Cron auth for /api/cron/kb-sync
# CRON_SECRET=your_cron_secret_here

# Optional: external API base URL for frontend (usually empty on Vercel)
# NEXT_PUBLIC_API_URL=
