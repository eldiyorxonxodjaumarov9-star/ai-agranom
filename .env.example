# ===========================================
# Vercel / Local Environment Variables
# ===========================================

# OpenAI (server only — never expose to frontend)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_TEXT_MODEL=gpt-5.4-mini
# OPENAI_VISION_MODEL=gpt-5.4-mini
# OPENAI_MAX_OUTPUT_TOKENS=1800
# VISION_IMAGE_DETAIL=high

# Public API authentication (Bearer token for external clients — never opens /api/admin/**)
AGRO_API_KEY=super_secret_api_key_here
# Admin-only identity (required for /api/admin/** and /api/admin/session)
ADMIN_API_KEY=replace_with_separate_admin_secret
# Production required for admin cookies (no AGRO_API_KEY fallback)
ADMIN_COOKIE_SECRET=replace_with_long_random_secret
# CHAT_COOKIE_SECRET=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://ai-agranom.vercel.app,https://agroolam.uz,https://www.agroolam.uz

# Optional: embedding model for Knowledge Base RAG
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL / Neon (Vercel integration)
# DATABASE_URL=postgresql://...
# DATABASE_URL_UNPOOLED=postgresql://...
# POSTGRES_URL_NON_POOLING=postgresql://...
# POSTGRES_PRISMA_URL=postgresql://...
# Preview builds must NOT migrate. Production migrate only with explicit flag:
# RUN_DB_MIGRATIONS=true

# KB_FORCE_CORPUS=0
# KB_LIVE_FETCH=0

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000

# KB_FETCH_ALLOWLIST=gd.eppo.int,extension.umn.edu
# OFFER_FRESHNESS_HOURS=72
# PARSER_BATCH_SIZE=20
# SOURCE_SELLER_SYNC_ENABLED=0

# KB_BOOTSTRAP_MAX_MS=240000
# KB_MIGRATE_CORPUS_ON_BUILD=0
# KB_EMBED_BATCH=32
# KB_EMBED_DELAY_MS=200

# NEXT_PUBLIC_API_URL=
